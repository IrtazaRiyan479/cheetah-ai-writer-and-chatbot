datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // Your binary targets are perfectly set up for Vercel deployments!
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text // Changed to @db.Text for MySQL compatibility with long tokens
  access_token       String? @db.Text // Changed to @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text // Changed to @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChatMessage {
  id        String   @id @default(cuid())
  senderId  String   // Will be 'user' or 'ai-assistant'
  message   String   @db.Text
  time      DateTime @default(now())
}

model Preset {
  id        String   @id @default(cuid())
  name      String   @unique
  settings  String   @db.Text // This will hold our JSON object of all fields
  createdAt DateTime @default(now())
}
